	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
		<EmbeddedResource Include="Infrastructure/Reportes/Fonts/OpenSans-Regular.ttf" />
