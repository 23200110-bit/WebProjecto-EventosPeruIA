<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<InternalsVisibleTo Include="EventosPeruIA.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Core\Settings\" />
		<Folder Include="Infrastructure\Data\" />
		<Folder Include="Infrastructure\Shared\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
